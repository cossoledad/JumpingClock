#pragma code_page(65001)
#include <windows.h>
#include "resources.h"

1 RT_MANIFEST "JumpingClock.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 300, 230
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "JumpingClock 设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "城市与时区", -1, 10, 9, 215, 12
    LISTBOX IDC_CLOCKS, 10, 24, 280, 60, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "添加", IDC_ADD, 10, 90, 44, 15
    PUSHBUTTON "编辑", IDC_EDIT, 59, 90, 44, 15
    PUSHBUTTON "移除", IDC_REMOVE, 108, 90, 44, 15

    AUTOCHECKBOX "显示城市", IDC_SHOWCITY, 10, 119, 65, 13
    AUTOCHECKBOX "显示时区", IDC_SHOWZONE, 81, 119, 65, 13
    AUTOCHECKBOX "登录后自启动", IDC_STARTUP, 152, 119, 135, 13
    LTEXT "悬浮窗不透明度（35–100%）", -1, 10, 141, 144, 12
    EDITTEXT IDC_OPACITY, 160, 138, 41, 15, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "探测 IPv4（留空关闭）", -1, 10, 163, 144, 12
    EDITTEXT IDC_TARGET, 160, 160, 130, 15, ES_AUTOHSCROLL
    LTEXT "", IDC_STATUS, 10, 182, 280, 20, SS_NOPREFIX
    DEFPUSHBUTTON "保存", IDOK, 189, 206, 48, 15
    PUSHBUTTON "取消", IDCANCEL, 242, 206, 48, 15
END

IDD_CLOCK DIALOGEX 0, 0, 280, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "编辑时钟"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "城市", -1, 10, 15, 41, 12
    EDITTEXT IDC_CITY, 55, 12, 215, 15, ES_AUTOHSCROLL
    LTEXT "时区", -1, 10, 40, 41, 12
    COMBOBOX IDC_ZONE, 55, 37, 215, 135, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "确定", IDOK, 169, 74, 48, 15
    PUSHBUTTON "取消", IDCANCEL, 222, 74, 48, 15
END
