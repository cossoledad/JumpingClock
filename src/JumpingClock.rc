#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resources.h"

1 RT_MANIFEST "JumpingClock.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 275, 193
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LISTBOX IDC_CLOCKS, 10, 10, 255, 52, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "添加", IDC_ADD, 10, 66, 38, 14
    PUSHBUTTON "移除", IDC_REMOVE, 52, 66, 38, 14

    LTEXT "城市", -1, 10, 91, 28, 12
    COMBOBOX IDC_CITY, 42, 88, 122, 126, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "IPv4", -1, 171, 91, 22, 12
    EDITTEXT IDC_TARGET, 195, 88, 70, 14, ES_AUTOHSCROLL
    RTEXT "", IDC_STATUS, 42, 105, 223, 12, SS_NOPREFIX

    AUTOCHECKBOX "城市", IDC_SHOWCITY, 10, 122, 53, 13
    AUTOCHECKBOX "时区", IDC_SHOWZONE, 67, 122, 53, 13
    AUTOCHECKBOX "登录自启", IDC_STARTUP, 124, 122, 77, 13
    LTEXT "不透明度", -1, 10, 145, 45, 12
    CONTROL "", IDC_OPACITY, TRACKBAR_CLASS, TBS_NOTICKS | WS_TABSTOP, 54, 139, 176, 20
    RTEXT "", IDC_OPACITY_VALUE, 230, 145, 35, 12

    DEFPUSHBUTTON "保存", IDOK, 173, 169, 44, 15
    PUSHBUTTON "取消", IDCANCEL, 221, 169, 44, 15
END
